KURIER_BASE_URL=https://api-testnet.kurier.xyz/api/v1
# Optional: get a testnet API key from https://testnet.kurier.xyz/ to enable Volta submission.
KURIER_API_KEY=
# Optional: locally generate 32 random bytes as hex and keep the value stable for existing receipts.
KURIER_RECEIPT_SECRET=
# Required only for /api/agent-games. Use the one-time value from the Games dashboard.
AGENT_GAMES_HMAC_SECRET=
# Optional legacy CLI override. The website registers its current key automatically.
KURIER_VK_HASH=

# Workspace (Supabase project URL and publishable key)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
